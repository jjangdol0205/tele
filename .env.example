# Telegram API (my.telegram.org 에서 발급)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# 수신용 개인 텔레그램 봇 토큰 (BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_MY_CHAT_ID=your_personal_chat_id_here

# Gemini API Key (Google AI Studio 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 감시할 텔레그램 채널들 (쉼표로 구분, 예: @channel1, @channel2)
TARGET_CHANNELS=@channel1,@channel2
